# Öffentliche Adresse deiner App (lokal: http://localhost:3000, später z. B. https://blotter-journal.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (öffentlich, darf in den Chat)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GEHEIM – nur in Vercel eintragen, nie in den Chat
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe → Produkt "Blotter Journal" → Preis 7,99 € monatlich → Preis-ID (price_…)
STRIPE_PRICE_ID=

# true, sobald Stripe Tax eingerichtet ist (berechnet die USt. automatisch)
STRIPE_AUTOMATIC_TAX=false
